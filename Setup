programa
{
	// ==========================================
	// VARIÁVEIS GLOBAIS DE ESTADO
	// ==========================================
	cadeia matriz_tabuleiro[5][5]
	inteiro bateria = 100
	inteiro creditos_obtidos = 0

	funcao inicio()
	{
		escreva("========================================\n")
		escreva("      INICIANDO CAÇA AO TESOURO         \n")
		escreva("========================================\n\n")

		// Inicializa a matriz 5x5 com posições vazias
		para (inteiro l = 0; l < 5; l++) {
			para (inteiro c = 0; c < 5; c++) {
				matriz_tabuleiro[l][c] = "   "
			}
		}

		escreva("Matriz 5x5 inicializada com sucesso!\n")
	}
}
